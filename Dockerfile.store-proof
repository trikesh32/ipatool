FROM golang:1.26.5-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -buildvcs=false -trimpath -o /out/ipatool .
WORKDIR /src/tools/store-proof
RUN go mod download && go build -buildvcs=false -trimpath -o /out/ipatool-store-proof .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ipatool /out/ipatool-store-proof /usr/local/bin/
COPY --from=build /src/LICENSE /usr/share/licenses/ipatool/LICENSE
COPY --from=build /src/tools/store-proof /usr/share/ipatool/store-proof-source/
ENV IPATOOL_STORE_PROOF_HELPER=/usr/local/bin/ipatool-store-proof
ENTRYPOINT ["/usr/local/bin/ipatool"]
